{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "symbol-art-parser",
  "version": "0.5.1",
  "description": "Phantasy Star Online 2 New Genesis Symbol Art file (*.sar) parser class.",
  "keywords": [
    "Symbol Art",
    "pso2",
    "pso2ngs",
    "ngs",
    "sa",
    "phantasy-star-online2"
  ],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/symbol-art-parser",
  "repository": "git@github.com:logue/symbol-art-parser.git",
  "bugs": "https://github.com/logue/symbol-art-parser/issues",
  "files": [
    "dist"
  ],
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.1.3",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "clean": "rimraf node_modules/.vite",
    "build": "run-p type-check build-only",
    "build:docs": "vite build --mode=docs",
    "build:clean": "rimraf dist",
    "build-only": "vite build",
    "type-check": "tsc --composite false",
    "lint": "eslint --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint && prettier . --write",
    "preview": "vite preview --mode=docs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-json-schema-validator": "^6.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "npm-run-all2": "^9.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-checker": "^0.13.0",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{js,ts,json,yml,yaml,htm,html}": "eslint --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint",
    "*": "prettier -w -u"
  },
  "dependencies": {
    "encoding-japanese": "^2.2.0"
  }
}