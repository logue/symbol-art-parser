{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "symbol-art-parser",
  "version": "0.6.1",
  "description": "Phantasy Star Online 2 New Genesis Symbol Art file (*.sar) parser class.",
  "keywords": [
    "Symbol Art",
    "pso2",
    "pso2ngs",
    "ngs",
    "sa",
    "phantasy-star-online2"
  ],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/symbol-art-parser",
  "repository": "git@github.com:logue/symbol-art-parser.git",
  "bugs": "https://github.com/logue/symbol-art-parser/issues",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "default": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.18.0",
  "sideEffects": false,
  "scripts": {
    "dev": "rslib --watch",
    "dev:docs": "rsbuild",
    "lint": "run-s lint:*",
    "lint:rslint": "rslint .",
    "lint:biome": "biome check --write",
    "build": "rslib build",
    "build:docs": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "clean": "rimraf dist docs",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.cache",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@microsoft/api-extractor": "^7.58.12",
    "@rsbuild/core": "^2.1.9",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.7.2",
    "@rstest/adapter-rslib": "^0.11.5",
    "@rstest/core": "^0.11.5",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*": "pnpm lint"
  }
}
